; PHP-FPM pool configuration for MISP
; This is a template processed by envsubst at startup.
; Runs as UID 1000 (misp) - no root required.

[global]
; No pid file: php-fpm runs in the foreground under tini, and nothing reads one
error_log = /dev/stderr
daemonize = no
; Longer lines are split; a JSON log line with a stack trace needs room
log_limit = 16384

[www]
; No user/group directives -- FPM runs as UID 1000, not root.

; Listen on TCP port 9002 (non-root compatible)
listen = [::]:9002

pm = dynamic
pm.max_children = ${PHP_FCGI_CHILDREN}
pm.start_servers = ${PHP_FCGI_START_SERVERS}
pm.min_spare_servers = ${PHP_FCGI_SPARE_SERVERS}
pm.max_spare_servers = ${PHP_FCGI_START_SERVERS}
pm.max_requests = ${PHP_FCGI_MAX_REQUESTS}

; Liveness and readiness probes hit this through caddy (/fpm-ping): it proves
; the FPM master and a worker answer, without touching the database.
ping.path = /fpm-ping
ping.response = pong

; Error logging -- log to stderr, never display in output (corrupts JSON API).
; Without catch_workers_output FPM sends a worker's stderr to /dev/null, and
; PHP errors and MISP's log (CakeLog on php://stderr) never leave the pod.
catch_workers_output = yes
decorate_workers_output = no
php_admin_value[error_log] = /dev/stderr
php_admin_flag[log_errors] = on
php_admin_flag[display_errors] = off
php_admin_flag[display_startup_errors] = off

; Ensure proper PATH for cake CLI
env[PATH] = /usr/local/bin:/usr/bin:/bin

; Clear env vars from PHP workers -- MISP reads config from config.php and DB,
; not from environment variables. No need to expose secrets to PHP.
clear_env = yes
