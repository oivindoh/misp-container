; PHP runtime configuration for MISP
; This is a template processed by envsubst at startup.
; Only overrides - the base php.ini from the OS package is used as the foundation.

[PHP]
; Never display PHP errors in output -- they corrupt JSON API responses.
; Errors are still logged to stderr (caught by container runtime).
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = /dev/stderr

memory_limit = ${PHP_MEMORY_LIMIT}
max_execution_time = ${PHP_MAX_EXECUTION_TIME}
upload_max_filesize = ${PHP_UPLOAD_MAX_FILESIZE}
post_max_size = ${PHP_POST_MAX_SIZE}
max_input_time = ${PHP_MAX_INPUT_TIME}
max_file_uploads = ${PHP_MAX_FILE_UPLOADS}
date.timezone = ${TZ}

[Session]
session.save_handler = redis
session.save_path = "${SESSION_SAVE_PATH}"
session.sid_length = 64
session.use_strict_mode = 1
