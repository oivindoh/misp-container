# Example org sync configuration.
# The chart's orgSync.orgs value takes this content; the org-sync Job reads it
# from the misp-orgs ConfigMap at /etc/misp-docker/orgs.yaml (docs/org-sync.md).
#
# Every string value expands ${ENV_VAR}; an unset variable stops the run.

taxonomies:
  - tlp

warninglists:
  - Top 10000 websites from Majestic Million
  - name: Sector specific top list
    enabled: true
    description: "sector sites and domains typically used extensively within"
    version: 20260515
    type: hostname
    matching_attributes:
      - hostname
      - domain
      - uri
      - url
    values:
      - github.com
      - x.ai
      - lets.try.that.again

tags:
  - tlp:clear

# roles:
#   - name: Custom Analyst
#     permission: 2
#     perm_tagger: true
#     perm_sighting: true
#     perm_analyst_data: true

teams:
  - uuid: 6959402f-4acd-49bb-be1a-1f30e9064d89
    # With Keycloak, the alias of the team's Keycloak organisation (docs/org-sync.md)
    name: example-team
    description: An example organisation
    sector: academic
    default_role: User

    # People log in through the identity provider and stay out of this list
    # (docs/org-sync.md, Keycloak)
    users:
      - email: sync-inbound@partner.no
        role: Sync user
        authkey: ${PARTNER_SYNC_KEY}
      - email: break-glass@example.com
        role: Org Admin
        password: ${BREAK_GLASS_PASSWORD}
      # - email: bot@example.com
      #   role: User
      #   authkey: ${BOT_KEY}
      # - email: header-user@example.com
      #   external_auth: true

    servers:
      - name: Partner MISP
        url: https://misp.partner.no
        authkey: ${OUR_KEY_ON_PARTNER}
        pull: true
        push: false
        pull_tags:
          - tlp:clear
        # Each push tag must be a tag in MISP (docs/org-sync.md, Servers)
        push_tags:
          - tlp:clear
        internal: false

    tags:
      - name: example-team:internal
        colour: "#aa0000"

