# Container defaults for every MISP pod: the chart's misp-env ConfigMap and the
# env_file of every Compose service read this file. The chart's env value and
# Compose's compose.env override it. MISP setting defaults live in settings.yaml.

# -- Instance --
MISP_BASEURL=https://misp.example.com
# MISP_EXTERNAL_BASEURL and SECURITY_REST_CLIENT_BASEURL inherit from
# MISP_BASEURL automatically. Only set them if they differ.
DEBUG=0
TZ=UTC

# -- Instance identity --
MISP_UUID=
# MISP_EMAIL, MISP_CONTACT, and GNUPG_EMAIL inherit from ADMIN_EMAIL automatically.
# Only set them if they need to differ.

# -- Admin --
ADMIN_EMAIL=admin@admin.test
ADMIN_ORG=ORGNAME

# -- Database --
# PostgreSQL; DB_HOST postgres is the postgres component and the Compose service
DB_HOST=postgres
DB_PORT=5432
DB_NAME=misp
DB_TLS=false

# -- Redis --
MISP_REDIS_HOST=redis
MISP_REDIS_PORT=6379

# -- Email --
SMTP_FQDN=mail
SMTP_PORT=25

# -- Modules (MISP appends port to URL separately, so URL must NOT include port) --
PLUGIN_ENRICHMENT_SERVICES_URL=http://modules

# -- GPG --
# Every pod imports the instance key from the misp-gnupg Secret (docs/kubernetes.md, Secrets)
GNUPG_HOMEDIR=/var/www/MISP/.gnupg

# -- Client addresses --
# The ingress or Gateway proxy pods, whose X-Forwarded-For caddy follows (docs/kubernetes.md,
# Client addresses). Unset, caddy trusts every private range, and a client with a private
# address is logged as the proxy.
# TRUSTED_PROXY_CIDR=10.244.0.0/16

# -- Logging --
# json: one JSON object per line, for a log collector; text: for a terminal
LOG_FORMAT=json

# -- Background jobs --
# The password is SIMPLEBACKGROUNDJOBS_SUPERVISOR_PASSWORD in secrets-app.env: the
# worker Service exposes supervisord to the namespace
SIMPLEBACKGROUNDJOBS_SUPERVISOR_HOST=worker
SIMPLEBACKGROUNDJOBS_SUPERVISOR_USER=supervisor
SIMPLEBACKGROUNDJOBS_SUPERVISOR_PORT=9001

# -- Paths --
MISP_ATTACHMENTS_DIR=/var/www/MISP/app/attachments
GNUPG_BINARY=/usr/bin/gpg

# -- Auth plugins (disabled by default, set to true to enable) --
# Their settings live in settings.yaml (groups oidc, ldap, apache_auth) and
# are rendered into config.php; see docs/configuration.md for the env vars.
OIDC_ENABLE=false
LDAPAUTH_ENABLE=false
APACHESECUREAUTH_LDAP_ENABLE=false

# -- Org sync --
ORG_CONFIG_FILE=/etc/misp-docker/orgs.yaml

# -- PHP --
PHP_MEMORY_LIMIT=2048M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_POST_MAX_SIZE=50M
PHP_MAX_INPUT_TIME=300
PHP_MAX_FILE_UPLOADS=50

# -- PHP-FPM pool --
PHP_FCGI_CHILDREN=5
PHP_FCGI_START_SERVERS=2
PHP_FCGI_SPARE_SERVERS=1
PHP_FCGI_MAX_REQUESTS=0

# -- Workers --
NUM_WORKERS_DEFAULT=5
NUM_WORKERS_PRIO=5
NUM_WORKERS_EMAIL=5
NUM_WORKERS_UPDATE=1
NUM_WORKERS_CACHE=5
# Per worker process; a job past it fails alone instead of the kubelet killing the
# pod (docs/kubernetes.md, Sizing). Unset: PHP_MEMORY_LIMIT.
# WORKER_MEMORY_LIMIT=2048M
