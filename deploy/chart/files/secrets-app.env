# Application secrets -- Secret misp-app. Set them in the chart's secrets.app value.
# Consumers: configure, web, worker, the redis component, console task CronJobs;
# metrics gets MISP_REDIS_PASSWORD only.
#
# Env var names follow the auto-derived convention from settings.yaml:
#   Security.salt -> SECURITY_SALT
MISP_REDIS_PASSWORD=change-me
GNUPG_PASSWORD=change-me
SECURITY_ENCRYPTION_KEY=
# SECURITY_SALT must be at least 32 characters and identical across replicas.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SALT=override-me-generate-a-real-64-char-hex-salt-with-python3-secret
