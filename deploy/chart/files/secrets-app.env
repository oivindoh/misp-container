# Application secrets -- Secret misp-app. Set them in the chart's secrets.app value.
# Consumers: configure and its migrate container, web, worker, the redis component, the task
# CronJobs; metrics gets MISP_REDIS_PASSWORD and PROXY_PASSWORD only.
#
# A key named after a setting is that setting's value (Security.salt -> SECURITY_SALT): the
# chart passes it to MISP by reference, so it never lands in a ConfigMap. A secret setting
# that has no key here (OIDC_CLIENT_SECRET, PROXY_PASSWORD) goes into secrets.app the same way.
MISP_REDIS_PASSWORD=change-me
GNUPG_PASSWORD=change-me
SECURITY_ENCRYPTION_KEY=
# SECURITY_SALT must be at least 32 characters and identical across replicas.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SALT=override-me-generate-a-real-64-char-hex-salt-with-python3-secret
