# Database credentials -- Secret misp-db. Set them in the chart's secrets.db value.
# Consumers: configure, web, worker, console task CronJobs, metrics (user and password only),
# org-sync, the mariadb or postgres component, housekeeping.
DB_USER=misp
DB_PASSWORD=change-me
# Root password of the mariadb component (unused with postgres)
MYSQL_ROOT_PASSWORD=change-me
