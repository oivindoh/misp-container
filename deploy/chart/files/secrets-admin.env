# Admin credentials -- Secret misp-admin. Set them in the chart's secrets.admin value.
# Consumers: configure, org-sync, the helm test pod. Web and worker pods never see these.
ADMIN_PASSWORD=change-me
# The admin's API key, 40 characters; the org sync and the helm test's API checks need it.
# Empty: the admin keeps the key MISP made at its first start, which nobody reads.
ADMIN_KEY=
