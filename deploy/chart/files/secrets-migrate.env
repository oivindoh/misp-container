# The source database of a migration (misp-migrate Secret). A read-only
# user on the source is enough. MIGRATE_SOURCE_PORT defaults to 3306 and
# MIGRATE_SOURCE_NAME to misp; MIGRATE_SOURCE_TLS=true for a TLS connection.
MIGRATE_SOURCE_HOST=change-me.example.com
MIGRATE_SOURCE_USER=misp
MIGRATE_SOURCE_PASSWORD=change-me
# MIGRATE_FORCE=true drops a non-empty target database first. A copy this
# Job made stays unless MIGRATE_REPLACE_COPY=true as well.
MIGRATE_FORCE=false
MIGRATE_REPLACE_COPY=false
# The source's attachments, from one of two places. A mounted copy of its
# attachments directory (the migrate.volumes value, docs/migration.md):
MIGRATE_SOURCE_FILES=
# Or its S3 bucket. The endpoint is for an AWS-compatible store; leave it
# empty for AWS. The Job signs with the access key. MIGRATE_SOURCE_S3_VALIDATE_CA
# defaults to true; MIGRATE_SOURCE_S3_CA names a CA bundle.
MIGRATE_SOURCE_S3_BUCKET=
MIGRATE_SOURCE_S3_ENDPOINT=
MIGRATE_SOURCE_S3_REGION=
MIGRATE_SOURCE_S3_ACCESS_KEY=
MIGRATE_SOURCE_S3_SECRET_KEY=
