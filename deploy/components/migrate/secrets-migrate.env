# The source database of a migration (misp-migrate Secret). A read-only
# user on the source is enough. MIGRATE_SOURCE_PORT defaults to 3306 and
# MIGRATE_SOURCE_NAME to misp; MIGRATE_SOURCE_TLS=true for a TLS connection.
MIGRATE_SOURCE_HOST=change-me.example.com
MIGRATE_SOURCE_USER=misp
MIGRATE_SOURCE_PASSWORD=change-me
# MIGRATE_FORCE=true drops a non-empty target database first.
MIGRATE_FORCE=false
# A mounted copy of the source's attachments directory (see job-migrate.yaml).
MIGRATE_SOURCE_FILES=
