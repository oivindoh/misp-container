# Compose-specific secret overrides (local dev only).
# Overrides the change-me placeholders in base/secrets.env.
DB_PASSWORD=misp-local-password
MYSQL_ROOT_PASSWORD=root-local-password
MISP_REDIS_PASSWORD=redis-local-password
GNUPG_PASSWORD=test-gpg-passphrase
ADMIN_PASSWORD=ChangeMe-Str0ng!Pass#2026
SECURITY_SALT=6f1c2b9d3e4a5f60718293a4b5c6d7e8f9a0b1c2d3e4f5061728394a5b6c7d8e
# MariaDB image needs MARIADB_* vars (same values as MYSQL_*)
MARIADB_USER=misp
MARIADB_PASSWORD=misp-local-password
MARIADB_ROOT_PASSWORD=root-local-password
# The postgres image reads POSTGRES_* (same values as DB_*)
POSTGRES_USER=misp
POSTGRES_PASSWORD=misp-local-password
