# MISP secret defaults -- CHANGE THESE in your overlay.
#
# Env var names follow the auto-derived convention from settings.yaml:
#   Security.salt -> SECURITY_SALT

# -- Database credentials --
MYSQL_USER=misp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# -- Redis --
MISP_REDIS_PASSWORD=change-me

# -- MISP secrets --
GNUPG_PASSWORD=change-me
SECURITY_ENCRYPTION_KEY=
# SECURITY_SALT must be at least 32 characters. Without it, passwords break on restart.
# CHANGE THIS in production! Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECURITY_SALT=override-me-generate-a-real-64-char-hex-salt-with-python3-secret

# -- Admin --
ADMIN_PASSWORD=change-me
# Leave empty to use auto-generated key. Set a 40-char value for cronjobs.
ADMIN_KEY=
