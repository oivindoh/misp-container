# The migration suite's Keycloak step (tests/e2e/test_migration.py): a migrated account has no
# OIDC subject, so its first Keycloak login links it by its verified email, and re-enables it
# when the org sync disabled it (docs/migration.md, Keycloak)
OIDCAUTH_ALLOW_EMAIL_LINKING=true
OIDCAUTH_UNBLOCK=true
