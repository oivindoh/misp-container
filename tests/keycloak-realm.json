{
  "realm": "misp",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "client": {
      "misp": [
        {"name": "read-only"},
        {"name": "user"},
        {"name": "publisher"},
        {"name": "org-admin"},
        {"name": "admin"}
      ]
    }
  },
  "groups": [
    {
      "name": "test-org",
      "attributes": {"organization": ["2399b00e-b7f4-4fdb-aeb9-03d28e83a210"]}
    }
  ],
  "clients": [
    {
      "clientId": "misp",
      "name": "MISP",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "misp-oidc-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://caddy:8080/users/login"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "misp",
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organization",
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "oidc",
      "email": "oidc@example.com",
      "emailVerified": true,
      "firstName": "Oidc",
      "lastName": "Tester",
      "enabled": true,
      "credentials": [{"type": "password", "value": "oidc-test-password", "temporary": false}],
      "groups": ["/test-org"],
      "realmRoles": ["default-roles-misp"],
      "clientRoles": {"misp": ["user", "org-admin"]}
    }
  ]
}
