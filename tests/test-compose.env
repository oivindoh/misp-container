# Test compose overrides -- used by tests/docker-compose.test.yml
# The base URL is the in-network name: the OIDC callback (baseurl + /users/login)
# must be reachable from the test client inside the compose network
MISP_BASEURL=http://caddy:8080
ADMIN_EMAIL=test-admin@example.com
ADMIN_ORG=Test Org
ADMIN_ORG_UUID=2399b00e-b7f4-4fdb-aeb9-03d28e83a210
MISP_UUID=2399b00e-b7f4-4fdb-aeb9-03d28e83a210
# The Kubernetes default, over compose.env's text: the suite checks the JSON lines
LOG_FORMAT=json
# OIDC through Keycloak (tests/keycloak-realm.json); mixed auth keeps the password form for
# the other tests. The client roles, highest first, so the highest role a user holds wins.
# No default organisation: the user lands in Test Org through the organization claim alone
OIDC_ENABLE=true
OIDC_PROVIDER_URL=http://keycloak:8080/realms/misp
OIDC_CLIENT_ID=misp
OIDC_CLIENT_SECRET=misp-oidc-test-secret
OIDC_ROLES_MAPPING={"admin": "admin", "org-admin": "Org Admin", "publisher": "Publisher", "user": "User", "read-only": "Read Only"}
OIDC_MIXEDAUTH=true
# Refresh tokens, so the user validity check asks Keycloak about the OIDC user
OIDCAUTH_OFFLINE_ACCESS=true
