# Test compose overrides -- used by tests/docker-compose.test.yml
# The base URL is the in-network name: the OIDC callback (baseurl + /users/login)
# must be reachable from the test client inside the compose network
MISP_BASEURL=http://caddy:8080
ADMIN_EMAIL=test-admin@example.com
ADMIN_ORG=Test Org
ADMIN_ORG_UUID=2399b00e-b7f4-4fdb-aeb9-03d28e83a210
MISP_UUID=2399b00e-b7f4-4fdb-aeb9-03d28e83a210
AUTOCONF_GPG=true
# OIDC through dex (tests/dex.yaml); mixed auth keeps the password form for the other tests
OIDC_ENABLE=true
OIDC_PROVIDER_URL=http://dex:5556/dex
OIDC_CLIENT_ID=misp
OIDC_CLIENT_SECRET=misp-oidc-test-secret
OIDC_ROLES_PROPERTY=email
OIDC_ROLES_MAPPING={"oidc@example.com": "Org Admin"}
OIDC_DEFAULT_ORG=Test Org
OIDC_MIXEDAUTH=true
