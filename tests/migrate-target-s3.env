# Points every MISP container at the migration's S3 target, a bucket in the
# test stack's garage (tests/e2e/test_migration.py imports this key there).
PLUGIN_S3_BUCKET_NAME=misp-migrated
PLUGIN_S3_AWS_ENDPOINT=http://garage:3900
PLUGIN_S3_REGION=garage
PLUGIN_S3_AWS_ACCESS_KEY=GK0123456789abcdef01234567
PLUGIN_S3_AWS_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
